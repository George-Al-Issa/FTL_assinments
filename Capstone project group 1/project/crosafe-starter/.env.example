CROSAFE_ADMIN_USER=admin
CROSAFE_ADMIN_PASSWORD=
CROSAFE_CUSTOMER_USER=customer
CROSAFE_CUSTOMER_PASSWORD=
# Optional additional customer accounts for split-account testing.
